[Unit]
Description=tinyFaaS Reverse Proxy
Documentation=https://github.com/OpenFogStack/tinyFaaS
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/tf-rproxy
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

# Environment variables (can be overridden in /etc/default/tinyfaas)
EnvironmentFile=-/etc/default/tinyfaas

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tf-rproxy

[Install]
WantedBy=multi-user.target
