[Unit]
Description=tinyFaaS Gateway
After=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/tf-gateway
Restart=on-failure
RestartSec=5s

# Environment variables (can be overridden in /etc/default/tf-gateway)
EnvironmentFile=-/etc/default/tf-gateway
Environment="GATEWAY_PORT=80"

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tf-gateway

[Install]
WantedBy=multi-user.target
