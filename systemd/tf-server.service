[Unit]
Description=tinyFaaS Server (merged manager + reverse proxy)
Documentation=https://github.com/OpenFogStack/tinyFaaS
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /var/lib/tinyfaas/tmp
ExecStart=/usr/local/bin/tf-server
Restart=on-failure
RestartSec=5

# Environment variables (can be overridden in /etc/default/tinyfaas)
EnvironmentFile=-/etc/default/tinyfaas

# Working directory
WorkingDirectory=/var/lib/tinyfaas

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tf-server

[Install]
WantedBy=multi-user.target
