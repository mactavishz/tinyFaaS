# Caddyfile for tinyFaaS Gateway
#
# This configuration sets up Caddy as a reverse proxy for tinyFaaS.
# - /fn/* routes to the rproxy for function invocation
# - /system/* routes to the manager for function management
#
# For development (HTTP only), use this file as-is.
# For production with HTTPS, replace ":80" with your domain name (e.g., "tinyfaas.com")
# and Caddy will automatically provision TLS certificates.

:80 {
	# Function invocation endpoint (rproxy)
	# Example: curl http://localhost/fn/myfunction
	handle_path /fn/* {
		rewrite * /invoke{path}
		reverse_proxy localhost:8000 {
			# Pass the original source IP to rproxy for call graph tracking
			header_up X-FaaS-Source-IP {remote_host}
		}
	}

	# Scale-up endpoint - restricted to rproxy only (internal service calls)
	# Only allows requests originating from localhost (rproxy service)
	handle_path /system/scale-up {
		@from_rproxy remote_ip 127.0.0.1 ::1
		handle @from_rproxy {
			rewrite * /scale-up
			reverse_proxy localhost:8080 {
				header_up X-FaaS-Source-IP {remote_host}
			}
		}
		handle {
			respond "Forbidden: scale-up endpoint is restricted to internal services only" 403
		}
	}

	# Heartbeat endpoint - restricted to rproxy only (internal service calls)
	# Only allows requests originating from localhost (rproxy service)
	handle_path /system/heartbeat {
		@from_rproxy remote_ip 127.0.0.1 ::1
		handle @from_rproxy {
			rewrite * /heartbeat
			reverse_proxy localhost:8080 {
				header_up X-FaaS-Source-IP {remote_host}
			}
		}
		handle {
			respond "Forbidden: heartbeat endpoint is restricted to internal services only" 403
		}
	}

	# Function management endpoint (manager)
	# Example: curl -X POST http://localhost/system/upload -d '...'
	handle_path /system/* {
		reverse_proxy localhost:8080 {
			header_up X-FaaS-Source-IP {remote_host}
		}
	}

	# Health check
	handle /health {
		respond "OK" 200
	}

	# Default response for root
	handle / {
		respond "tinyFaaS Gateway" 200
	}
}
